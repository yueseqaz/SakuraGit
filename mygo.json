{
  "name": "SakuraGit",
  "identifier": "dev.gitlane.desktop",
  "version": "0.10.3",
  "devUrl": "http://127.0.0.1:5274",
  "devCommand": "npm run dev:web",
  "buildCommand": "npm run build:web",
  "frontendDist": "dist",
  "bindings": "src/mygo.ts",
  "out": "build",
  "macos": {
    "minimumSystemVersion": "13.0"
  },
  "linux": {
    "command": "sakuragit",
    "categories": [
      "Development",
      "RevisionControl"
    ],
    "comment": "A lightweight visual Git desktop client",
    "depends": [
      "git",
      "fonts-noto-cjk"
    ]
  }
}
